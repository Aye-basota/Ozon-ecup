* text=auto eol=lf
*.parquet binary
*.npy binary
*.npz binary
*.pt binary
submissions/*.csv binary
reproducibility/**/*.csv binary
# Reproducibility manifests hash the preserved source/report bytes.  These
# files stay diffable, but Git must not rewrite their historical line endings.
reproducibility/**/*.py -text
reproducibility/**/*.json -text

# Materialized implementations are forensic byte copies.  Preserve source
# whitespace instead of treating historical trailing spaces as archive errors;
# generated catalogue envelopes remain under normal whitespace checks.
experiments/repro/**/implementation/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
